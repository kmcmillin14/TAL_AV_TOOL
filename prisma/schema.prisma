generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // PERSISTENT HEADER
  projectName      String
  customerName     String
  facilityLocation String?
  versionNumber    String   @default("v1.0")
  bastianRep       String?

  // STEP PROGRESS
  step1Complete Boolean @default(false)
  step2Complete Boolean @default(false)
  step3Complete Boolean @default(false)
  step4Complete Boolean @default(false)
  step5Complete Boolean @default(false)

  // Section 1: What are you moving?
  maxLoadWeightLbs         Float   @default(0)
  typicalUnitType          String  @default("")
  palletBottomBoard        String?
  customPalletDescription  String?
  otherUnitTypeDescription String?
  loadLengthIn             Float?
  loadWidthIn              Float?
  loadHeightIn             Float?

  // Section 2: How is it transferred?
  transferMethod  String  @default("")
  deliveryPattern String  @default("")
  maxLiftHeightFt Float?

  // Section 3: Where does it operate?
  minAisleWidthFt Float   @default(0)
  floorCondition  String  @default("")

  // Section 4: Operating Schedule
  shiftsPerDay         Int    @default(1)
  hoursPerShift        Float  @default(8)
  operatingDaysPattern String @default("")
  operatingDaysCustom  Json?
  breaksPerShift       Int    @default(0)
  breakDurationMin     Int    @default(0)

  // Section 5: Throughput & Distance
  requiredThroughputPerHour Int    @default(0)
  avgDistanceFt             Float  @default(0)
  distanceType              String @default("one_way")

  // Section 6: Labor & ROI
  operatorsPerShift Int @default(0)

  // Section 7: Ramps & Inclines
  rampDistanceFt Float @default(0)
  maxRampGrade   Float @default(0)

  // Section 8: Dealer Information
  oemDealer      String?
  dealershipName String?
  dealerRep      String?

  // Section 9: Certifications
  certifications Json @default("[]")

  // Section 10: Equipment Integration
  interlocks     Json    @default("[]")
  otherAGVs      Boolean @default(false)
  otherAGVVendor String?

  // Section 11: Environment (collapsed)
  tempMinF        Float?
  tempMaxF        Float?
  outdoorRequired Boolean @default(false)
  freezerCapable  Boolean @default(false)
  dustMoisture    String?

  // Section 12: Software (collapsed)
  wmsRequired Boolean @default(false)
  wmsVendor   String?

  // Section 13: Project Notes
  projectNotes String?

  @@index([createdAt])
  @@index([updatedAt])
  @@map("projects")
}
