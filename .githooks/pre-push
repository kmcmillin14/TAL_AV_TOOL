#!/bin/sh
# Pre-push gate — see CLAUDE.md "Pre-Push Checklist".
# Automates the mechanical validation steps. The judgment steps (docs first,
# /simplify, /review) are manual and listed in CLAUDE.md.
set -e

echo "▶ pre-push 1/3: TypeScript typecheck (tsc --noEmit)…"
npx tsc --noEmit

echo "▶ pre-push 2/3: architecture gate (npm run check:arch)…"
npm run check:arch

echo "▶ pre-push 3/3: tests (vitest run)…"
npx vitest run

echo "✓ pre-push checks passed."
echo "  Reminder: docs updated (SPECIFICATION + CHANGELOG)? /simplify + /review done?"
echo "  CSS edited? restart dev clean (rm -rf .next) so the served chunk isn't stale."
